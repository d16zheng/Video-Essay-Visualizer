{
  "name": "visualize-transcript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema-first MVP for turning written transcripts into structured story graphs.",
  "scripts": {
    "clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.json",
    "dev": "tsx --watch src/server/index.ts",
    "serve": "npm run build && node dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "extract": "tsx src/cli.ts"
  },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
