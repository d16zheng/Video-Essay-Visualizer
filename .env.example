OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# PostgreSQL or Supabase Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/visualize_transcript

# Set to require when your database provider needs SSL, such as Supabase.
DATABASE_SSL=require

# Optional: enable HTTP basic auth for the local app and APIs.
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=change-me
